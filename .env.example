# API Base URL
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Neon Postgres Connection Strings
# Use DATABASE_URL (pooled) for application queries
# Use DATABASE_URL_UNPOOLED (direct) for migrations and admin tasks

DATABASE_URL=postgresql://username:password@host-pooler.region.aws.neon.tech/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://username:password@host.region.aws.neon.tech/database?sslmode=verify-full

# JWT Authentication
# Generate a strong random secret for production (minimum 32 characters)
JWT_SECRET=your-secret-key-change-this-in-production-minimum-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
